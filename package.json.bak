{
  "name": "__SLUG__",
  "productName": "__PRODUCT_NAME__",
  "version": "__VERSION__",
  "description": "__DESCRIPTION__",
  "author": { "name": "Jules ROGUE", "email": "__AUTHOR_EMAIL__" },
  "homepage": "https://github.com/__OWNER__/__SLUG__",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder",
    "dist:win": "vite build && electron-builder --win",
    "dist:linux": "vite build && electron-builder --linux"
  },
  "dependencies": {
    "@fontsource/roboto": "5.3.0",
    "material-symbols": "0.48.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.2.1",
    "electron-builder": "26.18.1",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "com.julesrogue.__SLUG_ID__",
    "productName": "__PRODUCT_NAME__",
    "directories": { "output": "release", "buildResources": "build" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "icon": "build/icon.png",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }, { "target": "portable", "arch": ["x64"] }] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "artifactName": "${productName}-Setup-${version}.${ext}" },
    "portable": { "artifactName": "${productName}-${version}-portable.${ext}" },
    "linux": { "target": ["AppImage", "deb"], "category": "__LINUX_CATEGORY__", "maintainer": "Jules ROGUE <__AUTHOR_EMAIL__>" },
    "publish": null
  }
}
